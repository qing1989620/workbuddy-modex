{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ommw.dev/schemas/claim.schema.json",
  "title": "OMMW claim ledger entry",
  "type": "object",
  "required": ["claim_id", "statement", "status"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^C-\\d{3,4}$"},
    "statement": {"type": "string"},
    "type": {"type": "string"},
    "question": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "model_id": {"type": ["string", "null"]},
    "status": {"enum": ["PROPOSED", "SUPPORTED", "VERIFIED", "REJECTED"]},
    "confidence": {"enum": ["low", "medium", "high"]},
    "limitations": {"type": "string"},
    "used_in": {"type": "array", "items": {"type": "string"}}
  }
}
