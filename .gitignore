# --- Secrets & local config (NEVER commit) ---
.env
.env.local
config.local.toml
*.key
*.pem
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/printer/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
.venv2/
venv/

# --- OMMW runtime build artifacts ---
.build/
.cache/
ommw.egg-info/

# --- Local dev scratch (regenerable) ---
_smoke/
_smoke.prev-*/
_demo/
workspace/
projects/
workspace-*/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- WorkBuddy project data (memory, agent state; never publish) ---
.workbuddy/

# --- Keep publishable templates & reference.docx ---
!templates/**
!templates/word/reference.docx

# Template pipeline internals: staging is a rebuildable work copy (contains
# _compile_test logs/pdfs); the pristine originals live in raw/, the ready
# tree in normalized/. Reports and the registry ARE committed.
templates/local/staging/
