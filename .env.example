# Copy to .env (NEVER commit .env). All values optional; empty = auto-detect.
# Precedence: CLI flag > environment variable > config.local.toml > auto-detect > defaults.

# OMMW home directory (where the workflow core lives). Usually auto-detected.
# OMMW_HOME=

# Path to a local config file overriding defaults.
# OMMW_CONFIG=

# System tool locations (override auto-detection).
# TEXLIVE_HOME=D:\texlive\2026
# PANDOC_PATH=
# LIBREOFFICE_PATH=

# WorkBuddy skills directory (user-level by default).
# WORKBUDDY_SKILLS_DIR=

# --- Optional provider API keys (only if you enable those providers) ---
# Crossref polite email (recommended for citation metadata lookups)
# CROSSREF_MAILTO=you@example.com
# Tavily API key (used by MathModelAgent if enabled)
# TAVILY_API_KEY=
# OpenAI / Anthropic / Gemini (used by external agents, not by OMMW core)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
